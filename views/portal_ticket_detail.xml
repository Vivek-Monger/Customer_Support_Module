<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_ticket_detail" name="Ticket Detail">
    <t t-call="portal.portal_layout">
      <!-- Breadcrumbs -->
      <t t-set="breadcrumbs" t-value="[
        ('/my', 'My Account'),
        ('/my/tickets', 'Customer Support / My Tickets'),
        ('', ticket.ticket_id)
      ]"/>

      <div class="container mt-4">
        <!-- Header -->
        <div class="row mb-4">
          <div class="col-md-8">
            <h2>
              <span class="text-muted">Ticket #</span>
              <t t-esc="ticket.ticket_id"/>
            </h2>
            <h4 class="text-primary"><t t-esc="ticket.subject"/></h4>
          </div>
          <div class="col-md-4 text-end">
            <a href="/my/tickets" class="btn btn-secondary">
              <i class="fa fa-arrow-left"/> Back to Tickets
            </a>
          </div>
        </div>

        <div class="row">
          <!-- Main Content -->
          <div class="col-md-8">
            <!-- Status Card -->
            <div class="card shadow-sm mb-3">
              <div class="card-header bg-light">
                <h5 class="mb-0">Ticket Information</h5>
              </div>
              <div class="card-body">
                <div class="row mb-3">
                  <div class="col-md-6">
                    <strong>Status:</strong>
                    <span class="badge bg-info ms-2">
                      <t t-esc="phase_labels.get(ticket.phase_id, 'Unknown')"/>
                    </span>
                  </div>
                  <div class="col-md-6">
                    <strong>Priority:</strong>
                    <span class="badge ms-2"
                          t-att-class="'bg-secondary' if ticket.priority == '0' else 
                                       'bg-info' if ticket.priority == '1' else 
                                       'bg-warning' if ticket.priority == '2' else 'bg-danger'">
                      <t t-esc="priority_label"/>
                    </span>
                  </div>
                </div>

                <div class="row mb-3">
                  <div class="col-md-6">
                    <strong>Created:</strong>
                    <span class="ms-2">
                      <t t-esc="ticket.create_date.strftime('%Y-%m-%d %H:%M') if ticket.create_date else 'N/A'"/>
                    </span>
                  </div>
                  <div class="col-md-6">
                    <strong>Last Updated:</strong>
                    <span class="ms-2">
                      <t t-esc="ticket.write_date.strftime('%Y-%m-%d %H:%M') if ticket.write_date else 'N/A'"/>
                    </span>
                  </div>
                </div>

                <div class="row mb-3" t-if="ticket.assigned_user_id">
                  <div class="col-md-6">
                    <strong>Assigned To:</strong>
                    <span class="ms-2">
                      <t t-esc="ticket.assigned_user_id.name"/>
                    </span>
                  </div>
                  <div class="col-md-6" t-if="ticket.assigned_date">
                    <strong>Assigned On:</strong>
                    <span class="ms-2">
                      <t t-esc="ticket.assigned_date.strftime('%Y-%m-%d %H:%M')"/>
                    </span>
                  </div>
                </div>

                <div class="row" t-if="ticket.project_id">
                  <div class="col-md-12">
                    <strong>Project:</strong>
                    <span class="ms-2">
                      <t t-esc="ticket.project_id.project"/>
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Description Card -->
            <div class="card shadow-sm mb-3">
              <div class="card-header bg-light">
                <h5 class="mb-0">Description</h5>
              </div>
              <div class="card-body">
                <p class="mb-0" style="white-space: pre-wrap;">
                  <t t-esc="ticket.description or 'No description provided.'"/>
                </p>
              </div>
            </div>

            <!-- Attachments Card -->
            <div class="card shadow-sm mb-3" t-if="ticket.attachment_ids">
              <div class="card-header bg-light">
                <h5 class="mb-0">
                  Attachments
                  <span class="badge bg-secondary ms-2">
                    <t t-esc="len(ticket.attachment_ids)"/>
                  </span>
                </h5>
              </div>
              <div class="card-body">
                <div class="list-group">
                  <t t-foreach="ticket.attachment_ids" t-as="attachment">
                    <a t-att-href="'/web/content/%s?download=true' % attachment.id"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                       target="_blank">
                      <div>
                        <i class="fa fa-paperclip text-muted me-2"/>
                        <t t-esc="attachment.name"/>
                      </div>
                      <span class="badge bg-primary rounded-pill">
                        Download
                      </span>
                    </a>
                  </t>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="col-md-4">
            <!-- Phase History Card -->
            <div class="card shadow-sm mb-3" t-if="phase_history">
              <div class="card-header bg-light">
                <h5 class="mb-0">Phase History</h5>
              </div>
              <div class="card-body p-0">
                <div class="list-group list-group-flush">
                  <t t-foreach="phase_history" t-as="history">
                    <div class="list-group-item">
                      <div class="d-flex w-100 justify-content-between">
                        <small class="text-muted">
                          <t t-esc="history.change_date.strftime('%Y-%m-%d %H:%M') if history.change_date else 'N/A'"/>
                        </small>
                      </div>
                      <p class="mb-1 small">
                        <span class="text-muted">
                          <t t-esc="phase_labels.get(history.old_phase_id, 'New')"/>
                        </span>
                        <i class="fa fa-arrow-right mx-1"/>
                        <strong>
                          <t t-esc="phase_labels.get(history.new_phase_id, 'Unknown')"/>
                        </strong>
                      </p>
                      <small class="text-muted" t-if="history.changed_by">
                        Changed by: <t t-esc="history.changed_by.name"/>
                      </small>
                    </div>
                  </t>
                </div>
              </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card shadow-sm">
              <div class="card-header bg-light">
                <h5 class="mb-0">Quick Actions</h5>
              </div>
              <div class="card-body">
                <a href="/my/tickets" class="btn btn-outline-primary btn-sm w-100 mb-2">
                  <i class="fa fa-list"/> View All Tickets
                </a>
                <a href="/my/tickets/create" class="btn btn-outline-success btn-sm w-100">
                  <i class="fa fa-plus"/> Create New Ticket
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>