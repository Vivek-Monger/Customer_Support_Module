<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FAQ list View -->
    <record id="view_customer_support_faq_list" model="ir.ui.view">
        <field name="name">customer.support.faq.list</field>
        <field name="model">customer.support.faq</field>
        <field name="arch" type="xml">
            <list string="FAQs" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="view_count"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="created_by"/>
                <field name="last_updated"/>
            </list>
        </field>
    </record>

    <!-- FAQ Form View -->
    <record id="view_customer_support_faq_form" model="ir.ui.view">
        <field name="name">customer.support.faq.form</field>
        <field name="model">customer.support.faq</field>
        <field name="arch" type="xml">
            <form string="FAQ">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="Enter your question here..."/>
                            <field name="category_id" options="{'no_create': False}"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="view_count" readonly="1"/>
                            <field name="created_by" readonly="1"/>
                            <field name="last_updated" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="answer" widget="html" placeholder="Enter the answer here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

