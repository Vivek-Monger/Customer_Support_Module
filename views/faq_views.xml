    <!-- FAQ Category list View -->
    <record id="view_customer_support_faq_category_list" model="ir.ui.view">
        <field name="name">customer.support.faq.category.list</field>
        <field name="model">customer.support.faq.category</field>
        <field name="arch" type="xml">
            <list string="FAQ Categories" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="faq_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FAQ Category Form View -->
    <record id="view_customer_support_faq_category_form" model="ir.ui.view">
        <field name="name">customer.support.faq.category.form</field>
        <field name="model">customer.support.faq.category</field>
        <field name="arch" type="xml">
            <form string="FAQ Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="faq_count"/>
                    </group>
                    <notebook>
                        <page string="FAQs" name="faqs">
                            <field name="faq_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="view_count"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- FAQ Category Action -->
    <record id="action_customer_support_faq_category" model="ir.actions.act_window">
        <field name="name">FAQ Categories</field>
        <field name="res_model">customer.support.faq.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first FAQ Category
            </p>
            <p>
                Organize your FAQs into categories for better navigation.
            </p>
        </field>
    </record>

    <!-- Menu Items -->

    <menuitem id="menu_customer_support_faq_category"
              name="FAQ"
              parent="menu_customer_support_root"
              action="action_customer_support_faq_category"
              sequence="90"/>
</odoo>