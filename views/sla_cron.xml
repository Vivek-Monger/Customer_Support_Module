<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action to check SLA breaches every 30 minutes -->
        <record id="ir_cron_check_sla_breaches" model="ir.cron">
            <field name="name">Check SLA Breaches</field>
            <field name="model_id" ref="model_customer_support_sla_rule"/>
            <field name="state">code</field>
            <field name="code">model.check_sla_breaches()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>