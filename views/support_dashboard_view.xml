<odoo>
    <data>

        <record id="view_customer_support_dashboard_form" model="ir.ui.view">
            <field name="name">customer.support.dashboard.form</field>
            <field name="model">customer.support.dashboard</field>
            <field name="arch" type="xml">
                <form string="Support Dashboard"
                      create="false"
                      edit="false"
                      delete="false"
                      class="o_support_overview_dashboard">

                    <sheet>

                        <group col="3">
                            <field name="unassigned_count"/>
                            <field name="assigned_count"/>
                            <field name="today_count"/>
                        </group>

                        <separator string="All Tickets"/>

                        <field name="ticket_ids" nolabel="1">
                            <list create="false" delete="false">

                                <field name="ticket_id"/>
                                <field name="subject"/>
                                <field name="priority"/>
                                <field name="phase_id"/>

                                <!-- Editable ONLY for admin -->
                                <field name="assigned_user_id"
                                       groups="base.group_system"/>

                                <!-- Read-only for others -->
                                <field name="assigned_user_id"
                                       groups="!base.group_system"
                                       readonly="1"/>

                                <field name="create_date"/>

                            </list>
                        </field>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_customer_support_dashboard" model="ir.actions.act_window">
            <field name="name">Support Dashboard</field>
            <field name="res_model">customer.support.dashboard</field>
            <field name="view_mode">form</field>
        </record>

        <menuitem
            id="menu_customer_support_dashboard"
            name="Dashboard"
            parent="menu_customer_support_root"
            action="action_customer_support_dashboard"/>

    </data>
</odoo>
