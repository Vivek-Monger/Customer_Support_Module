<odoo>
  <data>

    <!-- Kanban View -->
    <record id="view_customer_support_kanban" model="ir.ui.view">
      <field name="name">customer.support.module.kanban</field>
      <field name="model">customer.support.module</field>
      <field name="arch" type="xml">
        <kanban
          default_group_by="phase_id"
          records_draggable="true"
          group_create="false"
          group_delete="false"
          create="false"
          class="o_kanban_small_column">

          <field name="phase_id"/>
          <field name="priority"/>
          <field name="assigned_user_id"/>
          <field name="create_date"/>

          <templates>
            <t t-name="card">
              <div class="oe_kanban_card oe_kanban_global_click">
                <div class="o_kanban_card_header">
                  <div class="o_kanban_card_header_title">
                    <strong><field name="ticket_id"/></strong>
                    <t t-if="record.priority.raw_value == '3'">
                      <span class="badge badge-danger float-right" style="background: #fee2e2 !important; color: #dc2626 !important; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600;">Urgent</span>
                    </t>
                    <t t-elif="record.priority.raw_value == '2'">
                      <span class="badge badge-warning float-right" style="background: #fed7aa !important; color: #ea580c !important; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600;">High</span>
                    </t>
                    <t t-elif="record.priority.raw_value == '1'">
                      <span class="badge badge-info float-right" style="background: #dbeafe !important; color: #2563eb !important; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600;">Medium</span>
                    </t>
                    <t t-else="">
                      <span class="badge badge-success float-right" style="background: #dcfce7 !important; color: #16a34a !important; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600;">Low</span>
                    </t>
                  </div>
                </div>
                
                <div class="o_kanban_card_content">
                  <div><field name="subject"/></div>
                </div>
                
                <div class="o_kanban_card_footer">
                  <div class="o_kanban_card_manage_pane">
                    <t t-if="record.create_date.raw_value">
                      <span style="background: #e0f2fe !important; color: #0369a1 !important; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center;">
                        <i class="fa fa-calendar" style="margin-right: 4px;"></i>
                        <field name="create_date" widget="datetime"/>
                      </span>
                    </t>
                  </div>
                  
                  <div t-if="record.assigned_user_id.raw_value" style="margin-top: 8px;">
                    <span style="background: #f1f5f9 !important; color: #64748b !important; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center;">
                      <i class="fa fa-user" style="margin-right: 4px;"></i>
                      <field name="assigned_user_id"/>
                    </span>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>


    <!-- List View-->
    <record id="view_customer_support_list_customer" model="ir.ui.view">
      <field name="name">customer.support.module.list.customer</field>
      <field name="model">customer.support.module</field>
      <field name="arch" type="xml">
        <list string="My Tickets" 
              class="o_list_view_card_style" 
              create="false" 
              delete="false"
              decoration-info="priority == '1'"
              decoration-warning="priority == '2'"
              decoration-danger="priority == '3'">
          
          <!-- Hidden fields for decoration conditions -->
          <field name="id" column_invisible="1"/>
          <field name="priority" column_invisible="1"/>
          <field name="phase_id" column_invisible="1"/>
          <field name="create_date" column_invisible="1"/>
          <field name="assigned_user_id" column_invisible="1"/>
          
          <!-- Visible card content -->
          <field name="ticket_id" string="Ticket ID"/>
          <field name="subject" string="Subject"/>
          <field name="description" string="Description"/>
          <field name="project_id" string="Project"/>
          
        </list>
      </field>
    </record>

    <!-- Form View -->
    <record id="customer_support_module_form_view" model="ir.ui.view">
          <field name="name">customer.support.module.form.view</field>
          <field name="model">customer.support.module</field>
          <field name="arch" type="xml">
              <form string="Support Ticket" class="customer_support_form" create="false">
                  <!-- Alert banner at top of form for breached SLA -->
                  <div class="alert alert-danger" role="alert" 
                       invisible="not sla_breached or phase_id in ['resolved', 'closed']">
                      <strong>⚠️ SLA BREACH:</strong> This ticket has exceeded its resolution deadline!
                  </div>
                  
                  <div class="alert alert-warning" role="alert" 
                       invisible="sla_status != 'approaching' or phase_id in ['resolved', 'closed']">
                      <strong>⏰ WARNING:</strong> SLA deadline is approaching (less than 2 hours remaining)!
                  </div>

                  <sheet>
                      <group>
                          <field name="subject" readonly='1'/>
                          <field name="description" readonly='1'/>
                          <field name="project_id" readonly='1'/>
                          <field name="priority" readonly='1'/>
                          <field name="phase_id"
                            widget="statusbar"
                            options="{'clickable': True}"
                            statusbar_visible="new,open,in_progress,resolved,closed"/>

                          <field name="assigned_user_id" groups="customer_support_module.group_admin, customer_support_module.group_support_agent"/>
                      </group>

                      <!-- SLA Information Group -->
                      <group string="SLA Information" name="sla_info">
                          <field name="sla_deadline" readonly="1"/>
                          <field name="time_to_deadline" readonly="1" 
                                 widget="float_time"
                                 decoration-danger="time_to_deadline &lt; 0"
                                 decoration-warning="time_to_deadline &lt; 2 and time_to_deadline &gt;= 0"/>
                          <field name="sla_status" readonly="1" 
                                 decoration-success="sla_status == 'on_time'"
                                 decoration-warning="sla_status == 'approaching'"
                                 decoration-danger="sla_status == 'breached'"/>
                          <field name="sla_breached" invisible="1"/>
                      </group>

                      <!-- Attachments Section - Multiple display options -->
                <notebook>
                    <page string="Attachments" name="attachments">
                        <field name="attachment_ids" widget="many2many_binary" 
                               options="{'accepted_file_extensions': '*'}"
                               readonly='1'/>
                    </page>
                </notebook>

                  </sheet>
              </form>
          </field>
      </record>

    <!-- Actions -->

    <record id="action_all_tickets" model="ir.actions.act_window">
        <field name="name">All Tickets</field>
        <field name="res_model">customer.support.module</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" ref="view_customer_support_kanban"/>
        <!-- No domain → shows all tickets -->
    </record>

    <record id="action_assigned_tickets" model="ir.actions.act_window">
    <field name="name">Assigned Tickets</field>
    <field name="res_model">customer.support.module</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[('assigned_user_id', '=', uid)]</field>
    <field name="view_id" ref="view_customer_support_kanban"/>
</record>

    <!-- Menus -->
     <menuitem
          id="menu_customer_support_root"
          name="Customer Support"
          sequence="10"
          groups="customer_support_module.group_admin,customer_support_module.group_support_agent"/>

    <menuitem
        id="menu_all_tickets"
        name="All Tickets"
        parent="menu_customer_support_root"
        action="action_all_tickets"
        sequence="10"
        groups="customer_support_module.group_admin"
    />

    <menuitem
      id="menu_assigned_tickets"
      name="Assigned Tickets"
      parent="menu_customer_support_root"
      action="action_assigned_tickets"
      groups="customer_support_module.group_support_agent"
      sequence="20"/>


  </data>
</odoo>
