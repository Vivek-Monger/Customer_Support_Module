    <!-- Notification Action -->
    <record id="action_customer_support_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">customer.support.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No notifications yet
            </p>
            <p>
                Notifications will appear here when ticket statuses change or SLA breaches occur.
            </p>
        </field>
    </record>

    <!-- SLA Breach Notifications Action -->
    <record id="action_sla_breach_notifications" model="ir.actions.act_window">
        <field name="name">SLA Breach Alerts</field>
        <field name="res_model">customer.support.notification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('notification_type', '=', 'sla_breach')]</field>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No SLA breaches
            </p>
            <p>
                Great! All tickets are within their SLA deadlines.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_customer_support_notification"
              name="Notifications"
              parent="customer_support_module.menu_customer_support_root"
              action="action_customer_support_notification"
              sequence="40"/>

    <menuitem id="menu_sla_breach_alerts"
              name="SLA Breach Alerts"
              parent="customer_support_module.menu_customer_support_root"
              action="action_sla_breach_notifications"
              sequence="41"
              groups="customer_support_module.group_admin,customer_support_module.group_support_agent"/>
</odoo>