<odoo>
  <template id="portal_create_ticket" name="Create Ticket">
    <t t-call="portal.portal_layout">
      <!-- Breadcrumbs -->
      <t t-set="breadcrumbs" t-value="[
        ('/my', 'My Account'),
        ('/my/tickets', 'Customer Support / My Tickets'),
        ('/my/tickets/create', 'Create Ticket')
      ]"/>
      
      <div class="container mt-4">
        <h2>Create a New Ticket</h2>
        
        <!-- Show alert if coming from confirmation -->
        <div class="alert alert-info" t-if="from_confirm">
          <i class="fa fa-info-circle"></i>
          Your form data has been preserved. You can make changes and resubmit.
          <t t-if="file_count and file_count > 0">
            <br/><strong><t t-esc="file_count"/> file(s) are still attached.</strong>
          </t>
        </div>
        
        <form action="/my/tickets/create/confirm" 
              method="post" 
              class="mt-3"
              enctype="multipart/form-data">
          
          <!-- CSRF Token -->
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          
          <!-- Subject -->
          <div class="mb-3">
            <label for="subject" class="form-label">Subject <span class="text-danger">*</span></label>
            <input type="text"
                   class="form-control"
                   name="subject"
                   id="subject"
                   required="required"
                   t-att-value="subject or ''"/>
          </div>
          
          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description <span class="text-danger">*</span></label>
            <textarea class="form-control"
                      name="description"
                      id="description"
                      rows="5"
                      required="required"><t t-esc="description or ''"/></textarea>
          </div>
          
          <!-- Priority -->
          <div class="mb-3">
            <label for="priority" class="form-label">Priority</label>
            <select class="form-select" name="priority" id="priority">
              <option value="0" t-att-selected="'selected' if priority == '0' else None">Low</option>
              <option value="1" t-att-selected="'selected' if priority == '1' else None">Medium</option>
              <option value="2" t-att-selected="'selected' if priority == '2' else None">High</option>
              <option value="3" t-att-selected="'selected' if priority == '3' else None">Urgent</option>
            </select>
          </div>
          
          <!-- Project -->
          <div class="mb-3">
            <label for="project_id" class="form-label">Project</label>
            <select class="form-select" name="project_id" id="project_id">
              <option value="">-- Select Project --</option>
              <t t-foreach="request.env['customer.project'].sudo().search([])" t-as="proj">
                <option t-att-value="proj.id"
                        t-att-selected="'selected' if project_id and int(project_id) == proj.id else None">
                  <t t-esc="proj.project"/>
                </option>
              </t>
            </select>
          </div>
          
          <!-- Attachments -->
          <div class="mb-3">
            <label for="attachment" class="form-label">Attachments (Optional)</label>
            
            <!-- Show preserved files if any -->
            <div class="alert alert-success mb-2" t-if="from_confirm and file_count and file_count > 0">
              <strong>Previously attached files:</strong>
              <ul class="mb-0">
                <li t-foreach="files" t-as="file">
                  <i class="fa fa-paperclip"></i> <t t-esc="file['filename']"/>
                </li>
              </ul>
              <small class="text-muted">These files will be included when you submit. You can add more files below.</small>
            </div>
            
            <input type="file"
                   class="form-control"
                   name="attachment"
                   id="attachment"
                   multiple="multiple"/>
            <small class="text-muted">
              You can upload multiple files.
            </small>
          </div>
          
          <!-- Buttons -->
          <div class="mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-arrow-right"></i> Continue to Confirmation
            </button>
            <a href="/my/tickets" class="btn btn-secondary ms-2">
              <i class="fa fa-times"></i> Cancel
            </a>
          </div>
        </form>
      </div>
    </t>
  </template>
</odoo>