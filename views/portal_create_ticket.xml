<odoo>
  <template id="portal_create_ticket" name="Create Ticket">
    <t t-call="portal.portal_layout">
      <!-- Breadcrumbs -->
      <t t-set="breadcrumbs" t-value="[
        ('/my', 'My Account'),
        ('/my/tickets', 'Customer Support / My Tickets'),
        ('/my/tickets/create', 'Create Ticket')
      ]"/>

      <div class="container mt-4">
        <h2>Create a New Ticket</h2>
        
        <form action="/my/tickets/create/confirm" method="post" class="mt-3"
              enctype="multipart/form-data">
          <!-- CSRF Token -->
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

          <!-- Subject -->
          <div class="mb-3">
            <label for="subject" class="form-label">Subject</label>
            <input type="text"
                   class="form-control"
                   name="subject"
                   id="subject"
                   required="1"
                   t-att-value="subject or ''"/>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control"
                      name="description"
                      id="description"
                      rows="5"
                      required="1"><t t-esc="description or ''"/></textarea>
          </div>

          <!-- Priority -->
          <div class="mb-3">
            <label for="priority" class="form-label">Priority</label>
            <select class="form-select" name="priority" id="priority">
              <option value="0" t-att-selected="priority == '0'">Low</option>
              <option value="1" t-att-selected="priority == '1'">Medium</option>
              <option value="2" t-att-selected="priority == '2'">High</option>
              <option value="3" t-att-selected="priority == '3'">Urgent</option>
            </select>
          </div>

          <!-- Project (Only customer's projects, disable expired) -->
          <div class="mb-3">
            <label for="project_id" class="form-label">Project</label>
            <t t-set="user_projects" t-value="request.env['customer.project'].sudo().search([('customer_id', '=', request.env.uid)], order='warranty_status,project_name')"/>
            
            <t t-if="user_projects">
              <select class="form-select" name="project_id" id="project_id" required="1">
                <option value="">-- Select a Project --</option>
                <t t-foreach="user_projects" t-as="proj">
                  <option t-att-value="proj.id"
                          t-att-selected="project_id and int(project_id) == proj.id"
                          t-att-disabled="proj.warranty_status == 'expired' and 'disabled' or None"
                          t-att-class="proj.warranty_status == 'expired' and 'text-muted' or ''">
                    <t t-esc="proj.project_name"/>
                    <t t-if="proj.warranty_status == 'active'"> ✓ (Active - <t t-esc="proj.days_remaining"/> days left)</t>
                    <t t-if="proj.warranty_status == 'expiring_soon'"> ⚠ (Expiring Soon - <t t-esc="proj.days_remaining"/> days left)</t>
                    <t t-if="proj.warranty_status == 'expired'"> ✗ (Warranty Expired)</t>
                  </option>
                </t>
              </select>
              <small class="form-text text-muted">
                Only projects with active warranty can be selected. Contact support to extend warranty.
              </small>
            </t>
            <t t-else="">
              <div class="alert alert-warning">
                You don't have any projects yet. Please contact your administrator to create a project for you.
              </div>
            </t>
          </div>

          <!-- Attachments -->
          <div class="mb-3">
            <label for="attachment" class="form-label">Attachments (Optional)</label>
            <input type="file"
                   class="form-control"
                   name="attachment"
                   id="attachment"
                   multiple="1"/>
            <small class="text-muted">
              You can upload multiple files. Supported formats: images, PDFs, documents.
            </small>
          </div>

          <!-- Buttons -->
          <button type="submit" class="btn btn-primary" t-att-disabled="not user_projects and 'disabled' or None">
            Create Ticket
          </button>
          <a href="/my/tickets" class="btn btn-secondary ms-2">
            Cancel
          </a>
        </form>
      </div>
    </t>
  </template>
</odoo>